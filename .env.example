# GuidOn Career browser client; set values from Firebase Console > Project settings > Your apps.
# Firebase Auth + Firestore/Functions resource project: guidon-career-fcda2.
# Google Cloud project 'guidon-career' is a distinct ID, not interchangeable.
# No real service-account keys, Gmail tokens, API provider secrets or CV data belong here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=guidon-career-fcda2
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Explicit release flag: leave false until Auth providers, Functions and Firestore have passed live tests.
VITE_GUIDON_CORE_ENABLED=false
# Development-only local emulators; never enable in a production Hosting build.
VITE_USE_FIREBASE_EMULATORS=false
